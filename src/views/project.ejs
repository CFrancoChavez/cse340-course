<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (project) { %>
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p>
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <h3>Categories</h3>
        <% if (categories && categories.length > 0) { %>
            <ul>
                <% categories.forEach(category => { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No categories assigned to this project.</p>
        <% } %>

    <% } else { %>
        <h2>Project Not Found</h2>
        <p>The service project you are looking for does not exist.</p>
    <% } %>
    <p>
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    </p>
</main>

<%- include('partials/footer') %>