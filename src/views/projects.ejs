<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong>
                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %>:
                </strong> 
                <%= project.title %> (<%= project.organization_name %>)
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>