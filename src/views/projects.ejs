<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong>
                    <%= new Date(project.project_date || project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %>:
                </strong> 
                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a> 
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
            </li>
        <% }); %>
    </ul>
    <p><a href="/new-project">Add a New Service Project</a></p>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project Details</a></p>
</main>

<%- include('partials/footer') %>