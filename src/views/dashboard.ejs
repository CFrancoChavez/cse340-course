<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View All Registered Users</a></p>
    <% } %>

    <h2>Your Volunteered Projects</h2>

    <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
        <ul>
            <% volunteeredProjects.forEach(project => { %>
                <li>
                    <strong>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </strong>
                    <% if (project.organization_name) { %>
                        - <%= project.organization_name %>
                    <% } %>
                    <br>
                    <span>
                        Date: <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %>
                    </span>
                    <br>
                    <a href="/projects/<%= project.project_id %>/unvolunteer">
                        Remove Volunteering
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not volunteered for any projects yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>